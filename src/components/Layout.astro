---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Omit on pages that should not be indexed (they get noindex instead). */
  canonical?: string;
  /** JSON-LD objects, serialised into one script tag each. */
  schema?: Record<string, unknown>[];
  ogImage?: string;
  /** Alt text for the social card image. */
  ogImageAlt?: string;
  /** Colours the browser chrome on mobile. */
  themeColor?: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  schema = [],
  ogImage,
  ogImageAlt,
  themeColor = '#ffffff',
  noindex = false,
} = Astro.props;

const origin = canonical ? new URL(canonical).origin : 'https://tisviamarketing.in';
const image = ogImage ?? `${origin}/og.png`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Manrope is self-hosted: no third-party connection, no render-blocking
       stylesheet from another origin. One variable file covers 400–800. -->
  <link
    rel="preload"
    href="/f/manrope-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tisvia Marketing" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

  <meta name="theme-color" content={themeColor} />

  <!-- SVG first for browsers that take it, .ico as the fallback every
       browser and crawler still asks for at the root. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {schema.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <slot />
</body>
</html>
