---
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import { CONTACT, SITES, wa } from '../../data/site';
import {
  DAYS,
  ENROLMENT,
  FAQS,
  INCLUDED,
  MENTOR_STATS,
  PHASES,
  PROBLEM,
  SAMPLE_DAY,
  TESTIMONIALS,
} from '../../data/academy';

const title = 'Tisvia Marketing Academy — 10-Day Live Meta Ads Mentorship';
const description =
  'Ten live Meta Ads sessions in Malayalam and English. Build, launch and optimise real campaigns in Ads Manager, with assignments and individual feedback. ₹9,999.';

const enquiry = wa("Hi, I'm interested in the 10-Day Meta Ads Mentorship Programme.");

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: '10-Day Meta Ads Mentorship Programme',
    description,
    url: `${SITES.academy}/`,
    inLanguage: ['ml', 'en'],
    teaches: [
      'Meta Ads campaign structure',
      'Meta Pixel and Conversions API tracking',
      'Audience targeting and creative strategy',
      'Lead generation and WhatsApp campaigns',
      'Performance analysis, optimisation and scaling',
    ],
    provider: {
      '@type': 'Organization',
      '@id': `${SITES.academy}/#organization`,
      name: 'Tisvia Marketing Academy',
      url: SITES.academy,
      logo: `${SITES.academy}/logo-academy.png`,
      sameAs: [CONTACT.instagram, CONTACT.linkedin],
      parentOrganization: { '@type': 'Organization', name: 'Tisvia Marketing', url: SITES.agency },
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT20H',
      inLanguage: ['ml', 'en'],
      instructor: {
        '@type': 'Person',
        name: 'Tismin Manoj',
        jobTitle: 'Performance marketer',
        image: `${SITES.academy}/tismin.jpg`,
        sameAs: CONTACT.linkedin,
      },
    },
    offers: {
      '@type': 'Offer',
      price: ENROLMENT.feeAmount,
      priceCurrency: ENROLMENT.currency,
      category: 'Paid',
      availability: 'https://schema.org/InStock',
      url: `${SITES.academy}/#enrol`,
    },
    syllabusSections: DAYS.map((d, i) => ({
      '@type': 'Syllabus',
      position: i + 1,
      name: `Day ${d.n} — ${d.t}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={`${SITES.academy}/`}
  schema={schema}
  ogImage={`${SITES.academy}/og.png`}
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar bar--over">
    <div class="wrap bar__inner">
      <a href="#top" class="bar__brand" aria-label="Tisvia Marketing Academy — top of page">
        <img src="/logo-academy.png" width="420" height="225" alt="Tisvia Marketing Academy" fetchpriority="high" />
      </a>
      <nav class="bar__nav" aria-label="Sections">
        <a href="#plan">The ten days</a>
        <a href="#mentor">Mentor</a>
        <a href="#enrol">Fee</a>
        <a href="#faq">Questions</a>
      </nav>
      <a class="btn btn--solid bar__cta" href={enquiry} target="_blank" rel="noopener">Enquire</a>
    </div>
  </header>

  <main id="main">
    <!-- ───────── hero ───────── -->
    <section class="hero" id="top">
      <div class="hero__bg" aria-hidden="true">
        <span class="glow glow--1"></span>
        <span class="glow glow--2"></span>
        <span class="glow glow--3"></span>
      </div>

      <div class="wrap hero__inner">
        <h1>Learn Meta ads by running them.</h1>
      </div>

      <a class="cue" href="#problem" aria-label="Scroll to the programme">
        <span class="cue__txt">Scroll</span>
        <span class="cue__line" aria-hidden="true"><span></span></span>
      </a>
    </section>

    <!-- ───────── 01 problem ───────── -->
    <section class="section" id="problem">
      <div class="wrap">
        <p class="eyebrow reveal">01 · The gap</p>
        <h2 class="reveal">Courses teach theory. Clients pay for campaigns.</h2>
        <p class="lede reveal" style="margin-top:18px">
          Ten days, two hours a day, live. You are inside a real ad account from the first week.
        </p>

        <ul class="pains reveal">
          {PROBLEM.map((p) => <li>{p}</li>)}
        </ul>

        <p class="close reveal">
          What is missing is usually <b>practice on a live account</b> and <b>someone checking your
          work</b>. Not another playlist.
        </p>
      </div>
    </section>

    <!-- ───────── 02 the ten days ───────── -->
    <section class="section section--defer" id="plan">
      <div class="wrap">
        <p class="eyebrow reveal">02 · The ten days</p>
        <h2 class="reveal">One live session a day</h2>
        <p class="lede reveal" style="margin-top:18px">
          Two hours, live on Zoom, Ads Manager on screen. Every session is recorded.
        </p>

        <div class="phases reveal">
          {PHASES.map((p) => (
            <article class="card">
              <span class="phase__d">{p.days}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>

        <ol class="days reveal" aria-label="The ten days">
          {DAYS.map((d) => (
            <li><span>{d.n}</span>{d.t}</li>
          ))}
        </ol>

        <p class="close reveal">
          <b>Also inside:</b> ten assignments with individual feedback, real client case studies,
          reporting templates and checklists, and recordings of every session.
        </p>
      </div>
    </section>

    <!-- ───────── 03 a sample day ───────── -->
    <section class="section section--defer" id="sample">
      <div class="wrap">
        <p class="eyebrow reveal">03 · A sample day</p>
        <h2 class="reveal">{SAMPLE_DAY.label}: {SAMPLE_DAY.title}</h2>
        <p class="lede reveal" style="margin-top:18px">{SAMPLE_DAY.intro}</p>

        <ol class="steps reveal">
          {SAMPLE_DAY.steps.map((s) => <li>{s}</li>)}
        </ol>

        <p class="close reveal">{SAMPLE_DAY.close}</p>
        <p class="note reveal" style="margin-top:10px">{SAMPLE_DAY.note}</p>
      </div>
    </section>

    <!-- ───────── 04 mentor ───────── -->
    <section class="section section--defer" id="mentor">
      <div class="wrap">
        <p class="eyebrow reveal">04 · Your mentor</p>

        <div class="mentor reveal">
          <picture>
            <source
              srcset="/tismin-sm.webp 560w, /tismin.webp 900w"
              sizes="min(100vw - 36px, 360px)"
              type="image/webp"
            />
            <img
              src="/tismin.jpg"
              srcset="/tismin-sm.jpg 560w, /tismin.jpg 900w"
              sizes="min(100vw - 36px, 360px)"
              width="900"
              height="1125"
              alt="Tismin Manoj, performance marketer and mentor at Tisvia Marketing Academy"
              loading="lazy"
              decoding="async"
            />
          </picture>

          <div class="mentor__text">
            <h2>Tismin Manoj</h2>
            <p class="lede" style="margin-top:16px">
              Performance marketer. Four years spending other people's money on Meta, from Thrissur
              to clients abroad — and now teaching the same account work he does every day.
            </p>

            <ul class="stats">
              {MENTOR_STATS.map((s) => (
                <li><b>{s.n}</b><span>{s.s}</span></li>
              ))}
            </ul>

            <a class="inline-link" href={CONTACT.linkedin} target="_blank" rel="noopener">
              LinkedIn <Icon name="arrow" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── 05 proof ───────── -->
    <section class="section section--defer" id="proof">
      <div class="wrap">
        <p class="eyebrow reveal">05 · Proof</p>
        <h2 class="reveal">What they sent afterwards</h2>

        <div class="shots reveal">
          {TESTIMONIALS.map((t) => (
            <figure>
              <picture>
                <source srcset={`${t.src}.webp`} type="image/webp" />
                <img src={`${t.src}.jpg`} width={t.w} height={t.h} alt={t.alt} loading="lazy" decoding="async" />
              </picture>
              <figcaption>{t.cap}</figcaption>
            </figure>
          ))}
        </div>

        <p class="note reveal" style="margin-top:24px">
          Unedited screenshots from students and clients. Personal phone numbers have been removed.
          These are their results, not a promise of yours.
        </p>
      </div>
    </section>

    <!-- ───────── 06 fee ───────── -->
    <section class="section section--defer" id="enrol">
      <div class="wrap">
        <p class="eyebrow reveal">06 · The programme</p>

        <div class="price reveal">
          <div class="price__head">
            <b>{ENROLMENT.fee}</b>
            <span>{ENROLMENT.feeUnit}</span>
          </div>

          <ul class="ticks">
            {INCLUDED.map((i) => (
              <li><Icon name="check" />{i}</li>
            ))}
          </ul>

          <a class="btn btn--solid price__btn" href={enquiry} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Enquire on WhatsApp
          </a>

          <p class="note">
            Any live advertising spend during the practical sessions is separate from the fee. The
            Certificate of Completion needs the assignments and the final assessment. A WhatsApp
            group and doubt-clearing sessions are proposed for the weeks after the programme.
          </p>
        </div>
      </div>
    </section>

    <!-- ───────── 07 questions ───────── -->
    <section class="section section--defer" id="faq">
      <div class="wrap">
        <p class="eyebrow reveal">07 · Questions</p>
        <h2 class="reveal">Before you message</h2>

        <div class="faq reveal">
          {FAQS.map((f) => (
            <details>
              <summary>{f.q}<span class="faq__i" aria-hidden="true"><Icon name="plus" /></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────── close ───────── -->
    <section class="section section--defer">
      <div class="wrap">
        <div class="cta reveal">
          <div>
            <h2>Ten days. One campaign running.</h2>
            <p class="cta__p">Message Tismin for the next start date and the session times.</p>
          </div>
          <a class="btn cta__btn" href={enquiry} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Enquire on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__inner">
      <p><b>Tisvia Marketing Academy</b>{CONTACT.location}</p>
      <nav class="foot__links" aria-label="Contact">
        <a href={enquiry} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${CONTACT.email}`}>Email</a>
        <a href={CONTACT.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={SITES.agency}>Tisvia Marketing</a>
      </nav>
    </div>
  </footer>

  <!-- phone-only: the price and the button never leave the screen -->
  <a class="dock" href={enquiry} target="_blank" rel="noopener">
    <span class="dock__p">{ENROLMENT.fee}<i>{ENROLMENT.feeUnit}</i></span>
    <span class="dock__b"><Icon name="whatsapp" /> Enquire</span>
  </a>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var calm = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!calm.matches && 'IntersectionObserver' in window) {
        root.classList.add('js-reveal');
        var seen = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-in');
                seen.unobserve(entries[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
        );
        var items = document.querySelectorAll('.reveal');
        for (var j = 0; j < items.length; j++) seen.observe(items[j]);

        // safety net: if nothing has fired, never leave content invisible
        setTimeout(function () {
          if (!document.querySelector('.reveal.is-in')) root.classList.remove('js-reveal');
        }, 2500);
      }

      // the bar sits on the gradient over the hero, and on white after it
      var bar = document.querySelector('.bar');
      var hero = document.querySelector('.hero');
      if (bar && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          function (e) { bar.classList.toggle('bar--over', e[0].isIntersecting); },
          { rootMargin: '-62px 0px 0px 0px' }
        ).observe(hero);
      }

      // the dock only shows once the hero is behind you
      var dock = document.querySelector('.dock');
      if (dock && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          function (e) { dock.classList.toggle('dock--on', !e[0].isIntersecting); },
          { rootMargin: '0px' }
        ).observe(hero);
      }
    })();
  </script>
</Layout>

<style>
  /* height of the sticky bar; the hero slides under it */
  .bar, .hero { --bar-h: 62px; }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--blue);
    color: #fff;
    padding: 12px 18px;
    border-radius: 0 0 8px 0;
    font-weight: 600;
    z-index: 20;
  }
  .skip:focus { left: 0; }

  /* ---- bar ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, .9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    transition: background-color .3s ease, border-color .3s ease;
  }

  /* over the gradient hero: no plate, light type */
  .bar--over {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .bar--over .bar__nav a { color: rgba(255, 255, 255, .8); }
  .bar--over .bar__nav a:hover { color: #fff; }
  .bar--over .bar__brand img { filter: brightness(0) invert(1); }
  .bar--over .bar__cta { background: #fff; color: var(--blue-deep); }
  .bar--over .bar__cta:hover { background: #e8ecff; }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: var(--bar-h);
  }
  .bar__brand img { width: 84px; height: auto; }
  .bar__nav {
    display: flex;
    gap: 24px;
    margin-left: auto;
    font-size: 14.5px;
    font-weight: 500;
  }
  .bar__nav a { color: var(--body); padding: 6px 0; transition: color .2s ease; }
  .bar__nav a:hover { color: var(--ink); }
  .bar__cta { min-height: 42px; padding: 0 20px; font-size: 14.5px; }

  @media (max-width: 880px) {
    .bar__nav { display: none; }
    .bar__cta { margin-left: auto; }
    /* backdrop-filter is the single most expensive thing a phone does while
       scrolling, and the bar is pinned the whole way down. Solid instead. */
    .bar { background: #fff; backdrop-filter: none; }
    .bar--over { background: transparent; }
  }
  @media (max-width: 400px) {
    .bar__brand img { width: 72px; }
    .bar__cta { padding: 0 16px; }
  }

  /* ---- hero ---- */
  .hero {
    position: relative;
    /* pull the hero up under the sticky bar so the gradient runs edge to edge */
    margin-top: calc(-1 * var(--bar-h));
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #0b1a6b;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* nothing inside can paint outside, so the browser never has to look */
    contain: strict;
  }

  /* Soft light pooling across the hero.
     These are radial gradients, NOT blurred boxes: a blur() filter re-renders
     an offscreen buffer every frame and was what made this page crawl on a
     phone. A gradient is painted once and then only moved by the compositor. */
  .glow {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    transform: translateZ(0);
  }

  .glow--1 {
    width: 95vmax; height: 95vmax;
    top: -40vmax; left: -28vmax;
    background: radial-gradient(closest-side, #3d5afe 0%, rgba(61, 90, 254, .55) 45%, rgba(61, 90, 254, 0) 100%);
    animation: drift1 28s ease-in-out infinite alternate;
  }
  .glow--2 {
    width: 82vmax; height: 82vmax;
    bottom: -34vmax; right: -24vmax;
    background: radial-gradient(closest-side, #6f8bff 0%, rgba(111, 139, 255, .45) 45%, rgba(111, 139, 255, 0) 100%);
    animation: drift2 34s ease-in-out infinite alternate;
  }
  .glow--3 {
    width: 62vmax; height: 62vmax;
    top: 20%; left: 36%;
    background: radial-gradient(closest-side, #1230b4 0%, rgba(18, 48, 180, .5) 50%, rgba(18, 48, 180, 0) 100%);
    animation: drift3 30s ease-in-out infinite alternate;
  }

  @keyframes drift1 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(10vmax, 7vmax, 0) scale(1.12); }
  }
  @keyframes drift2 {
    from { transform: translate3d(0, 0, 0) scale(1.08); }
    to   { transform: translate3d(-11vmax, -7vmax, 0) scale(1); }
  }
  @keyframes drift3 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(-8vmax, 9vmax, 0) scale(1.18); }
  }

  .hero__inner { text-align: center; }

  .hero h1 {
    color: #fff;
    font-size: clamp(31px, 5.4vw, 60px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.06;
    max-width: 18ch;
    margin-inline: auto;
  }

  /* ---- scroll cue ---- */
  .cue {
    position: absolute;
    bottom: max(20px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 10px 14px;
    color: rgba(255, 255, 255, .72);
    transition: color .2s ease;
  }
  .cue:hover { color: #fff; }

  .cue__txt {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .cue__line {
    width: 1px;
    height: 46px;
    background: rgba(255, 255, 255, .26);
    overflow: hidden;
    display: block;
  }
  .cue__line span {
    display: block;
    width: 100%;
    height: 50%;
    background: #fff;
    animation: cue 2.2s cubic-bezier(.7, 0, .3, 1) infinite;
  }
  @keyframes cue {
    0%   { transform: translateY(-100%); }
    60%  { transform: translateY(200%); }
    100% { transform: translateY(200%); }
  }
  @media (max-height: 620px) {
    .cue__line { height: 30px; }
  }

  /* ---- reveal on scroll ---- */
  :global(.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(18px);
  }
  :global(.js-reveal) .reveal.is-in {
    opacity: 1;
    transform: none;
    transition: opacity .6s cubic-bezier(.22, .61, .36, 1),
                transform .6s cubic-bezier(.22, .61, .36, 1);
  }

  /* ---- headings ---- */
  h2 { font-size: clamp(26px, 4.2vw, 40px); }

  .close {
    margin-top: clamp(26px, 4vw, 38px);
    font-size: clamp(16.5px, 2vw, 18.5px);
    max-width: 58ch;
  }
  .close b { color: var(--ink); font-weight: 700; }

  /* ---- 01 pains ---- */
  .pains {
    margin-top: clamp(30px, 4vw, 44px);
    display: grid;
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }
  .pains li {
    background: var(--bg);
    padding: 16px 0 16px 26px;
    position: relative;
    font-size: clamp(15.5px, 1.8vw, 17px);
    color: var(--ink);
  }
  .pains li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 1.05em;
    width: 10px;
    height: 1px;
    background: var(--blue);
  }

  /* ---- 02 phases + days ---- */
  .phases {
    margin-top: clamp(30px, 4vw, 44px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 860px) { .phases { grid-template-columns: 1fr; } }

  .phase__d {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--blue-deep);
    display: block;
    margin-bottom: 12px;
  }
  .phases h3 { font-size: 19px; }

  .days {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(20px, 4vw, 48px);
  }
  @media (max-width: 680px) { .days { grid-template-columns: 1fr; } }

  .days li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 13px 0;
    border-top: 1px solid var(--line);
    font-size: 15.5px;
    color: var(--ink);
  }
  .days li span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--muted);
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* ---- 03 steps ---- */
  .steps {
    margin-top: clamp(26px, 3.5vw, 36px);
    counter-reset: s;
    display: grid;
    gap: 2px;
    max-width: 62ch;
  }
  .steps li {
    counter-increment: s;
    position: relative;
    padding: 13px 0 13px 44px;
    border-top: 1px solid var(--line);
    font-size: clamp(15.5px, 1.8vw, 17px);
    color: var(--ink);
  }
  .steps li:last-child { border-bottom: 1px solid var(--line); }
  .steps li::before {
    content: counter(s, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 15px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--blue-deep);
    font-variant-numeric: tabular-nums;
  }

  /* ---- 04 mentor ---- */
  .mentor {
    margin-top: 10px;
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: start;
  }
  .mentor img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: var(--bg-soft);
  }
  @media (max-width: 860px) {
    .mentor { grid-template-columns: 1fr; gap: 28px; }
    .mentor picture { display: block; max-width: 360px; }
  }

  .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 600;
    color: var(--blue-deep);
    transition: gap .2s ease;
  }
