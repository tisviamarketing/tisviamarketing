---
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import { CONTACT, SITES, wa } from '../../data/site';
import { DAYS, ENROLMENT, FAQS, INCLUDED, MENTOR_STATS, TESTIMONIALS } from '../../data/academy';

const title = 'Performance Marketing Course — Tisvia Marketing Academy';
const description =
  'A 10-day live performance marketing course on Meta ads. Two hours a day, on a real ad account, in Malayalam and English. Learn to run ads that bring leads and sales. ₹9,999.';

const enquiry = wa("Hi, I'm interested in the performance marketing course.");

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: '10-Day Performance Marketing Course',
    description,
    url: `${SITES.academy}/`,
    inLanguage: ['ml', 'en'],
    teaches: [
      'Meta Ads campaign structure',
      'Meta Pixel and Conversions API tracking',
      'Audience targeting and ad creative',
      'Lead generation and WhatsApp campaigns',
      'Performance analysis, optimisation and scaling',
    ],
    provider: {
      '@type': 'Organization',
      '@id': `${SITES.academy}/#organization`,
      name: 'Tisvia Marketing Academy',
      url: SITES.academy,
      logo: `${SITES.academy}/logo-academy.png`,
      sameAs: [CONTACT.instagram, CONTACT.linkedin],
      parentOrganization: { '@type': 'Organization', name: 'Tisvia Marketing', url: SITES.agency },
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT20H',
      inLanguage: ['ml', 'en'],
      instructor: {
        '@type': 'Person',
        name: 'Tismin Manoj',
        jobTitle: 'Performance marketer',
        image: `${SITES.academy}/tismin.jpg`,
        sameAs: CONTACT.linkedin,
      },
    },
    offers: {
      '@type': 'Offer',
      price: ENROLMENT.feeAmount,
      priceCurrency: ENROLMENT.currency,
      category: 'Paid',
      availability: 'https://schema.org/InStock',
      url: `${SITES.academy}/#fee`,
    },
    syllabusSections: DAYS.map((d, i) => ({
      '@type': 'Syllabus',
      position: i + 1,
      name: `Day ${d.n} — ${d.t}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={`${SITES.academy}/`}
  schema={schema}
  ogImage={`${SITES.academy}/og.png`}
  ogImageAlt="Tisvia Marketing Academy — 10-day live performance marketing course"
>
  <a class="skip" href="#main">Skip to content</a>

  <noscript>
    <style>
      .bar {
        background: #fff !important;
        backdrop-filter: none !important;
        border-bottom-color: var(--line) !important;
      }
      .bar .bar__nav a { color: var(--body) !important; }
      .bar .bar__brand img { filter: none !important; }
      .bar .bar__cta { background: var(--blue) !important; color: #fff !important; }
    </style>
  </noscript>

  <header class="bar bar--over">
    <div class="wrap bar__inner">
      <a href="#top" class="bar__brand" aria-label="Tisvia Marketing Academy — top of page">
        <img src="/logo-academy.png" width="420" height="225" alt="Tisvia Marketing Academy" fetchpriority="high" />
      </a>
      <nav class="bar__nav" aria-label="Sections">
        <a href="#course">Course</a>
        <a href="#mentor">Mentor</a>
        <a href="#fee">Fee</a>
      </nav>
      <a class="btn btn--solid bar__cta" href={enquiry} target="_blank" rel="noopener">Enquire</a>
    </div>
  </header>

  <main id="main">
    <!-- ───────── hero ───────── -->
    <section class="hero" id="top">
      <div class="hero__bg" aria-hidden="true">
        <span class="glow glow--1"></span>
        <span class="glow glow--2"></span>
        <span class="glow glow--3"></span>
      </div>

      <div class="wrap hero__inner">
        <h1>Learn performance marketing.<br />Run ads that bring sales.</h1>

        <p class="hero__sub">
          A 10-day live course on Meta ads. Two hours a day, on a real ad account,
          in Malayalam and English.
        </p>

        <div class="hero__cta">
          <a class="btn btn--solid" href={enquiry} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Enquire now
          </a>
          <a class="btn btn--line" href="#course">See course details</a>
        </div>
      </div>
    </section>

    <!-- ───────── 1 · the course ───────── -->
    <section class="section" id="course">
      <div class="wrap">
        <h2 class="reveal">What the course is</h2>
        <p class="lede reveal" style="margin-top:18px">
          Ten days. One live session a day, two hours long, on Zoom with Ads Manager on screen.
          Every session is recorded and the recordings are yours. You work in a real ad account
          from the first week, and you get your work checked.
        </p>

        <h3 class="sub-h reveal">What you learn, day by day</h3>
        <ol class="days reveal" aria-label="The ten days">
          {DAYS.map((d) => (
            <li><span>{d.n}</span>{d.t}</li>
          ))}
        </ol>

        <h3 class="sub-h reveal">What you get</h3>
        <ul class="ticks reveal">
          {INCLUDED.map((i) => (
            <li><Icon name="check" />{i}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────── 2 · mentor and reviews ───────── -->
    <section class="section section--defer" id="mentor">
      <div class="wrap">
        <h2 class="reveal">Your mentor</h2>

        <div class="mentor reveal">
          <picture>
            <source
              srcset="/tismin-sm.webp 560w, /tismin.webp 900w"
              sizes="min(100vw - 36px, 360px)"
              type="image/webp"
            />
            <img
              src="/tismin.jpg"
              srcset="/tismin-sm.jpg 560w, /tismin.jpg 900w"
              sizes="min(100vw - 36px, 360px)"
              width="900"
              height="1125"
              alt="Tismin Manoj, performance marketer and mentor at Tisvia Marketing Academy"
              loading="lazy"
              decoding="async"
            />
          </picture>

          <div class="mentor__text">
            <h3>Tismin Manoj</h3>
            <p class="lede" style="margin-top:14px">
              Performance marketer. Four years running Meta and Google ads for clients in India
              and abroad. He teaches the same account work he does every day.
            </p>

            <ul class="stats">
              {MENTOR_STATS.map((s) => (
                <li><b>{s.n}</b><span>{s.s}</span></li>
              ))}
            </ul>

            <a class="inline-link" href={CONTACT.linkedin} target="_blank" rel="noopener">
              LinkedIn <Icon name="arrow" />
            </a>
          </div>
        </div>

        <h3 class="sub-h reveal" id="reviews">Reviews</h3>
        <div class="shots reveal">
          {TESTIMONIALS.map((t) => (
            <figure>
              <picture>
                <source srcset={`${t.src}.webp`} type="image/webp" />
                <img src={`${t.src}.jpg`} width={t.w} height={t.h} alt={t.alt} loading="lazy" decoding="async" />
              </picture>
              <figcaption>{t.cap}</figcaption>
            </figure>
          ))}
        </div>

        <p class="note reveal" style="margin-top:24px">
          Unedited screenshots from students and clients. Personal phone numbers have been removed.
          These are their results, not a promise of yours.
        </p>
      </div>
    </section>

    <!-- ───────── 3 · fee and questions ───────── -->
    <section class="section section--defer" id="fee">
      <div class="wrap">
        <h2 class="reveal">Fee</h2>

        <div class="price reveal">
          <div class="price__head">
            <b>{ENROLMENT.fee}</b>
            <span>{ENROLMENT.feeUnit}</span>
          </div>

          <a class="btn btn--solid price__btn" href={enquiry} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Enquire on WhatsApp
          </a>
        </div>

        <h3 class="sub-h reveal" id="faq">Questions</h3>
        <div class="faq reveal">
          {FAQS.map((f) => (
            <details>
              <summary>{f.q}<span class="faq__i" aria-hidden="true"><Icon name="plus" /></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__inner">
      <p><b>Tisvia Marketing Academy</b>{CONTACT.location}</p>
      <div class="foot__right">
        <nav class="foot__social" aria-label="Tisvia Marketing Academy elsewhere">
          <a href={enquiry} aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener"><Icon name="whatsapp" /></a>
          <a href={CONTACT.instagram} aria-label="Instagram" title="Instagram" target="_blank" rel="noopener"><Icon name="instagram" /></a>
          <a href={CONTACT.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin" /></a>
          <a href={`mailto:${CONTACT.email}`} aria-label="Email" title="Email"><Icon name="mail" /></a>
        </nav>
        <nav class="foot__links" aria-label="Policies">
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href="/refund/">Refunds &amp; cancellation</a>
          <a href={SITES.agency}>Tisvia Marketing</a>
        </nav>
      </div>
    </div>
  </footer>

  <!-- phone-only: the price and the button never leave the screen -->
  <a
    class="dock"
    href={enquiry}
    target="_blank"
    rel="noopener"
    aria-label={`Enquire on WhatsApp — ${ENROLMENT.fee} ${ENROLMENT.feeUnit}`}
  >
    <span class="dock__p">{ENROLMENT.fee}<i>{ENROLMENT.feeUnit}</i></span>
    <span class="dock__b"><Icon name="whatsapp" /> Enquire</span>
  </a>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var calm = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!calm.matches && 'IntersectionObserver' in window) {
        root.classList.add('js-reveal');
        var seen = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-in');
                seen.unobserve(entries[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
        );
        var items = document.querySelectorAll('.reveal');
        for (var j = 0; j < items.length; j++) seen.observe(items[j]);

        // safety net: if nothing has fired, never leave content invisible
        setTimeout(function () {
          if (!document.querySelector('.reveal.is-in')) root.classList.remove('js-reveal');
        }, 2500);
      }

      // the bar sits on the gradient over the hero, and on white after it
      var bar = document.querySelector('.bar');
      var hero = document.querySelector('.hero');
      if (bar && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          function (e) { bar.classList.toggle('bar--over', e[0].isIntersecting); },
          { rootMargin: '-62px 0px 0px 0px' }
        ).observe(hero);
      }

      // the dock only shows once the hero is behind you
      var dock = document.querySelector('.dock');
      if (dock && hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          function (e) { dock.classList.toggle('dock--on', !e[0].isIntersecting); },
          { rootMargin: '0px' }
        ).observe(hero);
      }
    })();
  </script>
</Layout>

<style>
  /* height of the sticky bar; the hero slides under it */
  .bar, .hero { --bar-h: 62px; }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--blue);
    color: #fff;
    padding: 12px 18px;
    border-radius: 0 0 8px 0;
    font-weight: 600;
    z-index: 20;
  }
  .skip:focus { left: 0; }

  /* ---- bar ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, .9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    transition: background-color .3s ease, border-color .3s ease;
  }

  /* over the gradient hero: no plate, light type */
  .bar--over {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .bar--over .bar__nav a { color: rgba(255, 255, 255, .8); }
  .bar--over .bar__nav a:hover { color: #fff; }
  .bar--over .bar__brand img { filter: brightness(0) invert(1); }
  .bar--over .bar__cta { background: #fff; color: var(--blue-deep); }
  .bar--over .bar__cta:hover { background: #e8ecff; }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: var(--bar-h);
  }
  .bar__brand img { width: 84px; height: auto; }
  .bar__nav {
    display: flex;
    gap: 24px;
    margin-left: auto;
    font-size: 14.5px;
    font-weight: 500;
  }
  .bar__nav a { color: var(--body); padding: 6px 0; transition: color .2s ease; }
  .bar__nav a:hover { color: var(--ink); }
  .bar__cta { min-height: 42px; padding: 0 20px; font-size: 14.5px; }

  @media (max-width: 880px) {
    .bar__nav { display: none; }
    .bar__cta { margin-left: auto; }
    /* backdrop-filter is the single most expensive thing a phone does while
       scrolling, and the bar is pinned the whole way down. Solid instead. */
    .bar { background: #fff; backdrop-filter: none; }
    .bar--over { background: transparent; }
  }
  @media (max-width: 400px) {
    .bar__brand img { width: 72px; }
    .bar__cta { padding: 0 16px; }
  }

  /* ---- hero ---- */
  .hero {
    position: relative;
    /* pull the hero up under the sticky bar so the gradient runs edge to edge */
    margin-top: calc(-1 * var(--bar-h));
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #0b1a6b;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* nothing inside can paint outside, so the browser never has to look */
    contain: strict;
  }

  /* Soft light pooling across the hero.
     These are radial gradients, NOT blurred boxes: a blur() filter re-renders
     an offscreen buffer every frame and was what made this page crawl on a
     phone. A gradient is painted once and then only moved by the compositor. */
  .glow {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    transform: translateZ(0);
  }

  .glow--1 {
    width: 95vmax; height: 95vmax;
    top: -40vmax; left: -28vmax;
    background: radial-gradient(closest-side, #3d5afe 0%, rgba(61, 90, 254, .55) 45%, rgba(61, 90, 254, 0) 100%);
    animation: drift1 28s ease-in-out infinite alternate;
  }
  .glow--2 {
    width: 82vmax; height: 82vmax;
    bottom: -34vmax; right: -24vmax;
    background: radial-gradient(closest-side, #6f8bff 0%, rgba(111, 139, 255, .45) 45%, rgba(111, 139, 255, 0) 100%);
    animation: drift2 34s ease-in-out infinite alternate;
  }
  .glow--3 {
    width: 62vmax; height: 62vmax;
    top: 20%; left: 36%;
    background: radial-gradient(closest-side, #1230b4 0%, rgba(18, 48, 180, .5) 50%, rgba(18, 48, 180, 0) 100%);
    animation: drift3 30s ease-in-out infinite alternate;
  }

  @keyframes drift1 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(10vmax, 7vmax, 0) scale(1.12); }
  }
  @keyframes drift2 {
    from { transform: translate3d(0, 0, 0) scale(1.08); }
    to   { transform: translate3d(-11vmax, -7vmax, 0) scale(1); }
  }
  @keyframes drift3 {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(-8vmax, 9vmax, 0) scale(1.18); }
  }

  .hero__inner { text-align: center; }

  .hero h1 {
    color: #fff;
    font-size: clamp(30px, 5.2vw, 58px);
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.1;
    max-width: 20ch;
    margin-inline: auto;
  }

  .hero__sub {
    margin: clamp(20px, 3vh, 28px) auto 0;
    max-width: 48ch;
    font-size: clamp(16.5px, 2vw, 20px);
    line-height: 1.6;
    letter-spacing: 0;
    color: rgba(255, 255, 255, .84);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: clamp(28px, 4vh, 40px);
  }
  /* on blue, the primary button inverts */
  .hero__cta :global(.btn--solid) { background: #fff; color: var(--blue-deep); }
  .hero__cta :global(.btn--solid:hover) { background: #e8ecff; }
  .hero__cta :global(.btn--line) { border-color: rgba(255, 255, 255, .38); color: #fff; }
  .hero__cta :global(.btn--line:hover) { border-color: #fff; background: rgba(255, 255, 255, .1); }

  /* the <br> stays at every width: there is no space behind it, so hiding it
     runs "marketing." straight into "Run". */
  @media (max-width: 460px) {
    .hero__cta :global(.btn) { width: 100%; }
  }

  /* ---- reveal on scroll ---- */
  :global(.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(18px);
  }
  :global(.js-reveal) .reveal.is-in {
    opacity: 1;
    transform: none;
    transition: opacity .6s cubic-bezier(.22, .61, .36, 1),
                transform .6s cubic-bezier(.22, .61, .36, 1);
  }

  /* ---- headings ---- */
  h2 { font-size: clamp(26px, 3.6vw, 38px); }

  /* the heading inside a section; a clear step down from the section heading */
  .sub-h {
    font-size: clamp(18px, 2.1vw, 21px);
    margin-top: clamp(42px, 6vw, 68px);
    margin-bottom: 4px;
    scroll-margin-top: 76px;
  }

  /* ---- the ten days ---- */
  .days {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(20px, 4vw, 48px);
  }
  @media (max-width: 680px) { .days { grid-template-columns: 1fr; } }

  .days li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 13px 0;
    border-top: 1px solid var(--line);
    font-size: 16.5px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
  }
  .days li span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--muted);
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* ---- what you get ---- */
  .ticks { display: flex; flex-direction: column; gap: 11px; margin-top: 18px; }
  .ticks li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    font-size: 16.5px;
    line-height: 1.55;
    letter-spacing: 0;
    color: var(--ink);
  }
  .ticks :global(svg) { width: 16px; height: 16px; color: var(--blue); margin-top: 4px; }

  /* ---- mentor ---- */
  .mentor {
    margin-top: clamp(26px, 3.5vw, 38px);
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: start;
  }
  .mentor img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: var(--bg-soft);
  }
  .mentor__text h3 { font-size: clamp(22px, 2.8vw, 28px); }
  @media (max-width: 860px) {
    .mentor { grid-template-columns: 1fr; gap: 28px; }
    .mentor picture { display: block; max-width: 360px; }
  }

  .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 600;
    color: var(--blue-deep);
    transition: gap .2s ease;
  }
  .inline-link :global(svg) { width: 15px; height: 15px; }
  .inline-link:hover { gap: 11px; }

  /* ---- stats ---- */
  .stats {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .stats li {
    background: var(--bg);
    padding: 18px clamp(14px, 2vw, 22px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stats b { font-size: clamp(22px, 3vw, 29px); color: var(--blue); letter-spacing: -0.02em; line-height: 1.1; }
  .stats span { font-size: 12.5px; color: var(--muted); line-height: 1.4; }

  /* ---- reviews ---- */
  .shots {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 2.5vw, 26px);
    align-items: start;
  }
  @media (max-width: 820px) { .shots { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .shots { grid-template-columns: 1fr; max-width: 400px; } }

  .shots figure { margin: 0; }
  .shots img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-soft);
  }
  .shots figcaption { margin-top: 11px; font-size: 13.5px; color: var(--muted); }

  /* ---- fee ---- */
  .price {
    margin-top: clamp(22px, 3vw, 30px);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: clamp(26px, 4vw, 44px);
    max-width: 580px;
  }
  .price__head { display: flex; align-items: baseline; gap: 10px; }
  .price__head b {
    font-size: clamp(34px, 5vw, 46px);
    color: var(--ink);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .price__head span { font-size: 14px; color: var(--muted); }

  .price__btn { margin-top: 26px; width: 100%; }

  /* ---- questions ---- */
  .faq { margin-top: 14px; border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 19px 2px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: clamp(16.5px, 1.9vw, 18px);
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq p { padding: 0 2px 24px; max-width: 62ch; font-size: 16px; line-height: 1.7; }

  .faq__i {
    margin-left: auto;
    flex: none;
    display: grid;
